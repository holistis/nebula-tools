{
  "name": "nebula-tools",
  "version": "0.1.0",
  "description": "Shared tools for Nebula Notebook and Nexus Agentic IDE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nebula-mcp": "./bin/nebula-mcp.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./notebook": "./dist/notebook/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./_archived": "./dist/_archived/index.js",
    "./_archived/*": "./dist/_archived/*/index.js",
    "./gemini-cli": "./gemini-cli/dist/index.js",
    "./gemini-cli/*": "./gemini-cli/dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rm -rf dist",
    "mcp": "node dist/mcp/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "glob": "^11.0.0",
    "strip-ansi": "^7.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
