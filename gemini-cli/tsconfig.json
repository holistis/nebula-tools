{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "index.ts",
    "config/**/*.ts",
    "confirmation-bus/**/*.ts",
    "core/**/*.ts",
    "policy/**/*.ts",
    "ide/**/*.ts",
    "services/**/*.ts",
    "telemetry/**/*.ts",
    "tools/tools.ts",
    "tools/tool-names.ts",
    "tools/tool-error.ts",
    "tools/tool-registry.ts",
    "tools/mcp-tool-stub.ts",
    "tools/diffOptions.ts",
    "tools/modifiable-tool.ts",
    "tools/read-file.ts",
    "tools/write-file.ts",
    "tools/edit.ts",
    "tools/glob.ts",
    "tools/grep.ts",
    "tools/ls.ts",
    "tools/shell.ts",
    "tools/web-fetch.ts",
    "tools/web-search.ts",
    "tools/free-web-search.ts",
    "tools/free-web-fetch.ts",
    "tools/write-todos.ts",
    "tools/ripGrep.ts",
    "tools/smart-edit.ts",
    "utils/debugLogger.ts",
    "utils/fileUtils.ts",
    "utils/LruCache.ts",
    "utils/promptIdContext.ts",
    "utils/llm-edit-fixer.ts",
    "utils/pathCorrector.ts",
    "utils/errors.ts",
    "utils/paths.ts",
    "utils/formatters.ts",
    "utils/summarizer.ts",
    "utils/shell-utils.ts",
    "utils/terminalSerializer.ts",
    "utils/ignorePatterns.ts",
    "utils/textUtils.ts",
    "utils/safeJsonStringify.ts",
    "utils/schemaValidator.ts",
    "utils/events.ts",
    "utils/retry.ts",
    "utils/delay.ts",
    "utils/httpErrors.ts",
    "utils/googleQuotaErrors.ts",
    "utils/googleErrors.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
